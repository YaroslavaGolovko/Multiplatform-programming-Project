<UserControl x:Class="AtelierApp.UC.ControlOrder"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AtelierApp.UC"
             mc:Ignorable="d" 
             d:DesignHeight="150" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="1" Text="Заказ за" HorizontalAlignment="Right" Margin="5" FontSize="16" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="2" Text="{Binding RegistrationDate, StringFormat='{}{0:MM/dd/yyyy}'}" HorizontalAlignment="Left" Margin="5" FontSize="16" VerticalAlignment="Center"/>
        <TextBlock Style="{StaticResource TextBlockTrigger}" Grid.Column="2" HorizontalAlignment="Left" Margin="100 5 5 5" FontSize="16" VerticalAlignment="Center">
            <Run Text="(выдан: "/><Run Text="{Binding CompletionDate, StringFormat='{}{0:MM/dd/yyyy}'}"/><Run Text=" )"/></TextBlock>
        <TextBlock Grid.Column="1" Grid.Row="1" HorizontalAlignment="Center" Margin="5" FontSize="16" VerticalAlignment="Center"><Run Text="{Binding Client.LastName}"/><Run Text=" "/><Run Text="{Binding Client.FirstName}"/></TextBlock>
        <TextBlock Grid.Column="2" Grid.Row="1" Text="{Binding Service.Title}" HorizontalAlignment="Left" Margin="5" FontSize="16" VerticalAlignment="Center"></TextBlock>
        <TextBlock Grid.Column="1" Grid.Row="2" Grid.ColumnSpan="2" HorizontalAlignment="Left" Margin="150 5 5 5" FontSize="14" VerticalAlignment="Center"><Run Text="Цена: "/><Run Text="{Binding Price, StringFormat={}{0:0.00}}"/><Run Text=" руб."/></TextBlock>
        <Button Name="btnUpdate" Grid.Column="1" Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Left" Content="Редактировать" Click="btnUpdate_Click"/>
        <Button Name="btnCreateCheck" Grid.Column="2" Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Left" Content="Сформировать чек" Click="btnCreateCheck_Click"/>
        <Border Grid.RowSpan="4" Grid.Column="0" BorderThickness="2" BorderBrush="#FFBD86AB"/>
        <Image Grid.RowSpan="4" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Fill"  Panel.ZIndex="-1">
            <Image.Source>
                <Binding Path="Image">
                    <Binding.TargetNullValue>
                        <ImageSource>/AtelierApp;component/Resources/default.jpg</ImageSource>
                    </Binding.TargetNullValue>
                </Binding>
            </Image.Source>
        </Image>
        <Border Grid.ColumnSpan="3" Grid.RowSpan="4" BorderBrush="#FFBD86AB" BorderThickness="2"/>

    </Grid>
</UserControl>
