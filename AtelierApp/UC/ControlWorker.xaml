<UserControl x:Class="AtelierApp.UC.ControlWorker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AtelierApp.UC"
             mc:Ignorable="d" 
             d:DesignHeight="70" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>
        <TextBlock HorizontalAlignment="Center" Margin="5" FontSize="16" VerticalAlignment="Center"><Run Text="{Binding LastName}"/><Run Text=" "/>
            <Run Text="{Binding FirstName}"/><Run Text=" "/><Run Text="{Binding Patronymic}"/></TextBlock>
        <TextBlock Grid.Column="1" Text="{Binding TypeOfWorker.Name}" HorizontalAlignment="Center" Margin="5" FontSize="14" VerticalAlignment="Center"/>
        <Border BorderBrush="#FFBD86AB" BorderThickness="2"/>
        <Button Grid.Column="2" Name="btnEdit" Content="Редактировать" Click="btnEdit_Click"/>
        <Border Grid.ColumnSpan="3" BorderBrush="#FFBD86AB" BorderThickness="2"/>
        <Border Grid.ColumnSpan="2" BorderBrush="#FFBD86AB" BorderThickness="2"/>
    </Grid>
</UserControl>
