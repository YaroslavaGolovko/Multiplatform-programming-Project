<UserControl x:Class="AtelierApp.UC.ControlTextile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AtelierApp.UC"
             mc:Ignorable="d" 
             d:DesignHeight="150" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Title}" HorizontalAlignment="Center"
                   Margin="5" FontSize="16" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Grid.Row="1" HorizontalAlignment="Center" Margin="5" FontSize="16" VerticalAlignment="Center">
            <Run Text="Стоимость: "/><Run Text="{Binding Cost, StringFormat={}{0:0.00}}"/><Run Text=" руб."/></TextBlock>
        <TextBlock Name="tblInStock" Grid.Column="2" Grid.Row="1" HorizontalAlignment="Center" Margin="5" FontSize="16" VerticalAlignment="Center" Style="{StaticResource TextBlockInStock}"></TextBlock>
        <Button  Name="btnUpdate" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center" 
                 Content="Редактировать" Click="btnUpdate_Click"/>
        <Border Grid.RowSpan="4" Grid.Column="0" BorderThickness="2" BorderBrush="#FFBD86AB"/>
        <Image Grid.RowSpan="4" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Fill"  Panel.ZIndex="-1">
            <Image.Source>
                <Binding Path="Image">
                    <Binding.TargetNullValue>
                        <ImageSource>/AtelierApp;component/Resources/default.jpg</ImageSource>
                    </Binding.TargetNullValue>
                </Binding>
            </Image.Source>
        </Image>
        <Border Grid.ColumnSpan="3" Grid.RowSpan="4" BorderBrush="#FFBD86AB" BorderThickness="2"/>
    </Grid>
</UserControl>
