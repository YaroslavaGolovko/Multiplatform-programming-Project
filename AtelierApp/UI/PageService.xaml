<Page x:Class="AtelierApp.UI.PageService"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AtelierApp.UI"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PageService" Loaded="Page_Loaded">

    <Grid>
        <TextBlock Text="Название:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="50 50 10 10" FontSize="20"/>
        <TextBox Name="tbName" Text="{Binding Title}" HorizontalAlignment="Center" VerticalAlignment="Top"
                 Width="400" Margin="10 50 10 10" FontSize="20"/>
        <TextBlock Text="Стоимость (руб.):" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="50 10 10 10" FontSize="20"/>
        <TextBox Name="tbCost" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Cost}"
                 Width="320" Margin="10" FontSize="20" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"></TextBox>
        <Button Name="btnSave" VerticalAlignment="Bottom" HorizontalAlignment="Center" Click="BtnSave_Click" Content="Сохранить"/>
    </Grid>
</Page>
