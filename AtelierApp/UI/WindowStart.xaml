<Window x:Class="AtelierApp.WindowStart"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AtelierApp"
        mc:Ignorable="d"
        Title="Рада Best" Height="500" Width="800" MinWidth="800" MinHeight="500" WindowStartupLocation="CenterScreen" Icon="/AtelierApp;component/Resources/icon.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="2" Background="#FFD6BDD5"/>
        <Grid Background="#ffd6bdce"/>
        <TextBlock Name="MainTextBlock" Text="Рада Best" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5" FontFamily="Cambria"/>
        <Image Margin="5 5 5 5" HorizontalAlignment="Left" Source="/AtelierApp;component/Resources/logo.png" Height="50" Width="50"/>
        <Frame Name="MainFrame" Grid.Row="1"  NavigationUIVisibility="Hidden"></Frame>
        <Grid Grid.Row="1">
            <TextBlock Text="Введите логин:" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0 40 0 0" FontSize="20"/>
            <TextBlock Text="Введите пароль:" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0 120 0 0" FontSize="20"/>
            <TextBox Name="tbLogin" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0 80 0 0" Width="175" Height="30" VerticalContentAlignment="Center" FontSize="16"/>
            <TextBox Name="tbPassword" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0 160 0 0" Style="{StaticResource TextBoxTrigger}" Visibility="Hidden" VerticalContentAlignment="Center" FontSize="16"/>
            <PasswordBox Name="pbPassword" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0 160 0 0" Style="{StaticResource PasswordBoxTrigger}" VerticalContentAlignment="Center" FontSize="16"/>
            <CheckBox Name="cbPassword" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0 200 0 0"  Style="{StaticResource CheckBoxTrigger}" Content="Посмотреть пароль" Click="CbPassword_Click" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
            <Button Name="btnEnter" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0 240 0 0" Content="Войти" Click="BtnEnter_Click" />
        </Grid>
    </Grid>
</Window>
