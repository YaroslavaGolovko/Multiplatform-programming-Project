<Page x:Class="AtelierApp.UI.PageDiagramServices"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AtelierApp.UI"
      xmlns:charts="clr-namespace:System.Windows.Forms.DataVisualization.Charting;assembly=System.Windows.Forms.DataVisualization"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PageDiagramServices" Loaded="Page_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="1" Text="Вид диаграммы:" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="13 5 10 10"/>
        <ComboBox Grid.Row="1" Name="cmbType" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="150 10 10 10" Width="200" Height="30"
                  SelectionChanged="CmbType_SelectionChanged" SelectedIndex="0" VerticalContentAlignment="Center"></ComboBox>
        <TextBlock Text="Начало периода:" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10 5 10 10"/>
        <DatePicker Name="dateStart" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="150 10 10 10" Width="200"
                    SelectedDateChanged="DateStart_SelectedDateChanged" DisplayDateStart="2022-01-01" VerticalContentAlignment="Center" SelectedDateFormat="Long"/>
        <TextBlock Text="Конец периода:" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="400 5 10 10"/>
        <DatePicker Name="dateEnd" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="535 10 10 10" Width="200"
                    SelectedDateChanged="DateEnd_SelectedDateChanged" DisplayDateStart="2022-01-01" VerticalContentAlignment="Center" SelectedDateFormat="Long"/>
        <WindowsFormsHost Grid.Row="2" Margin="10 5 10 10" Background="Transparent">
            <charts:Chart x:Name="chartServices">
                <charts:Chart.Legends>
                    <charts:Legend/>
                </charts:Chart.Legends>
            </charts:Chart>
        </WindowsFormsHost>
        <TextBlock Name="tblNoResult" Text="Нет результатов" Grid.Row="2"
                   VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="25" Visibility="Hidden"/>
    </Grid>
</Page>
