<Window x:Class="AtelierApp.UI.WindowWork"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AtelierApp.UI"
        mc:Ignorable="d"
        Title="Рада Best" Height="600" Width="1000" MinWidth="1000" MinHeight="600" WindowStartupLocation="CenterScreen" Icon="/AtelierApp;component/Resources/icon.ico" Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Grid.ColumnSpan="2">
            <Grid Background="#ffd6bdce"/>
            <TextBlock Name="MainTextBlock" Text="Рада Best" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5" FontFamily="Cambria"/>
            <Image Margin="5 5 5 5" HorizontalAlignment="Left" Source="/AtelierApp;component/Resources/logo.png" Height="50" Width="50"/>
        </Grid>
        <Frame Grid.Column="1" Grid.Row="1" Name="MainFrame" NavigationUIVisibility="Hidden"/>
        <Grid Grid.Row="2" Grid.ColumnSpan="2" Background="#FFD6BDD5"/>
        <Grid Grid.Column="0"  Grid.Row="1">
            <TextBlock Name="tblUser" Text="Логин: admin" VerticalAlignment="Top" Margin="0 10 0 0" FontSize="20" HorizontalAlignment="Center"/>
            <Grid Panel.ZIndex="-1">
                <Grid.Background>
                    <SolidColorBrush Color="#FFDF9DC9" Opacity="0.34"/>
                </Grid.Background>
            </Grid>
            <Button Name="btnOrder" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0 60 0 0" Click="BtnOrder_Click">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/AtelierApp;component/Resources/orders.png" VerticalAlignment="Center" Margin="1"/>
                    <TextBlock Text="   Заказы" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Name="btnClient" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0 120 0 0" Click="BtnClient_Click">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/AtelierApp;component/Resources/clients.png" VerticalAlignment="Center" Margin="1"/>
                    <TextBlock Text="   Клиенты" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Name="btnWorker" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0 180 0 0" Click="BtnWorker_Click">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/AtelierApp;component/Resources/workers.png" VerticalAlignment="Center" Margin="1"/>
                    <TextBlock Text="   Сотрудники" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Name="btnTextile" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0 240 0 0" Click="btnTextile_Click">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/AtelierApp;component/Resources/textile.png" VerticalAlignment="Center" Margin="1"/>
                    <TextBlock Text="   Ткани" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Name="btnService" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0 300 0 0" Click="btnService_Click">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/AtelierApp;component/Resources/services.png" VerticalAlignment="Center" Margin="1"/>
                    <TextBlock Text="   Услуги" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Name="btnBack" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0 360 0 0" Content="Назад" Click="BtnBack_Click"></Button>
            <Button Name="btnExit" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="5 5 5 10" Click="btnExit_Click">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/AtelierApp;component/Resources/logout.png" VerticalAlignment="Center" Margin="1"/>
                    <TextBlock Text="   Выход" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>

