<Page x:Class="AtelierApp.UI.PageTextile"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AtelierApp.UI"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PageTextile" Loaded="Page_Loaded">

    <Grid>
        <TextBlock Text="Название: " FontSize="20" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="30 50 10 10"/>
        <TextBox Name="tbName" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="150 50 10 10"
                  Width="250" Height="30" Text="{Binding Title}"/>
        <TextBlock Text="Цена:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="70 120 0 0" FontSize="20"/>
        <TextBox Name="tbCost" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="150 120 10 10"
                  Width="250" Height="30" Text="{Binding Cost}"/>
        <Image Name="imageTextile"  HorizontalAlignment="Right" VerticalAlignment="Top" Stretch="Fill" Width="300" Height="260" Margin="10 50 50 10">
            <Image.Source>
                <Binding Path="Image">
                    <Binding.TargetNullValue>
                        <ImageSource>/AtelierApp;component/Resources/default.jpg</ImageSource>
                    </Binding.TargetNullValue>
                </Binding>
            </Image.Source>
        </Image>
        <Border BorderThickness="2" BorderBrush="#FFBD86AB" HorizontalAlignment="Right" VerticalAlignment="Top" Width="300" Height="260"
                Margin="10 50 50 10" Panel.ZIndex="1"/>
        <RadioButton Name="rbInStock" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="150 180 0 0"
                     Content="В наличии" FontSize="20" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Width="120"/>
        <RadioButton Name="rbNotInStock" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="150 250 0 0" IsChecked="True"
                     Content="Нет в наличии" FontSize="20" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Width="150"/>
        <Button Name="btnSelectImage" Content="Выбрать фото" HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                Margin="5 5 200 5" Click="btnSelectImage_Click"/>
        <Button Name="btnSave" Content="Сохранить" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="btnSave_Click"/>
    </Grid>
</Page>
