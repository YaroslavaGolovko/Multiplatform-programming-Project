<Page x:Class="AtelierApp.UI.PageListTextile"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AtelierApp.UI"
      xmlns:uc="clr-namespace:AtelierApp.UC"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PageListTextile" Loaded="Page_Loaded">

    <Grid>
        <TextBlock Text="Поиск по названию:" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10 15 10 10" FontSize="14"/>
        <TextBox Name="tbSearch" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="150 10 10 10" ToolTip="Введите название ткани" TextChanged="tbSearch_TextChanged" VerticalContentAlignment="Center" Height="30" Width="600"></TextBox>
        <TextBlock Text="Сортировка:" FontSize="14" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="60 55 0 0"/>
        <ComboBox Name="cmbSort" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="150 50 0 0" Height="30" SelectionChanged="cmbSort_SelectionChanged" Width="260" SelectedIndex="0" VerticalContentAlignment="Center">
            <TextBlock Name="tblDefault" Text="По умолчанию" FontSize="14"/>
            <TextBlock Name="tblPriceAsc" Text="По цене: по возрастанию" FontSize="14"/>
            <TextBlock Name="tblPriceDesc" Text="По цене: по убыванию" FontSize="14"/>
        </ComboBox>
        <DataGrid Name="DGridTextile" AutoGenerateColumns="False" 
                  MinWidth="760" Height="auto" VerticalAlignment="Top" HorizontalAlignment="Center" Background="Transparent" MinColumnWidth="740"
                  RowHeight="150" IsReadOnly="True" Margin="10 95 10 50" HorizontalContentAlignment="Center" HeadersVisibility="Column" CanUserAddRows="False">
            <DataGrid.RowHeaderStyle>
                <Style TargetType="DataGridRowHeader">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate/>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.RowHeaderStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <uc:ControlTextile/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="Нет результатов" Name="tblSearch" Visibility="Hidden" FontSize="20"/>
        <Button Name="btnDelete" HorizontalAlignment="Right" VerticalAlignment="Bottom" Content="Удалить ткань" Click="btnDelete_Click"/>
        <Button Name="btnAdd" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="5 5 200 5" Content="Добавить ткань" Click="btnAdd_Click"/>
        <Border BorderThickness="2" BorderBrush="#FFBD86AB" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="450 50 0 0" Height="30" Width="300" CornerRadius="10" Background="#FFD6BDCE" Opacity="0.9">
            <StackPanel Orientation="Horizontal">
                <RadioButton Name="rbAll" Content="Все ткани" Margin="30 0 30 0" FontSize="14" IsChecked="True" Click="rbAll_Click" />
                <RadioButton Name="rbInStock" Content="В наличии" Margin="30 0 30 0" FontSize="14" Click="rbInStock_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
