<Page x:Class="AtelierApp.UI.PageClient"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AtelierApp.UI"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PageClient" Loaded="Page_Loaded">

    <Grid>
        <TextBlock Text="Фамилия:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="80 50 10 10" FontSize="20"/>
        <TextBox Name="tbLastName" Text="{Binding LastName}" HorizontalAlignment="Center" VerticalAlignment="Top"
                 Width="400" Margin="10 50 10 10" FontSize="20"/>
        <TextBlock Text="Имя:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="120 120 10 10" FontSize="20"/>
        <TextBox Name="tbFirstName" Text="{Binding FirstName}" HorizontalAlignment="Center" VerticalAlignment="Top"
                 Width="400" Margin="10 120 10 10" FontSize="20"/>
        <TextBlock Text="Отчество:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="80 190 10 10" FontSize="20"/>
        <TextBox Name="tbPatronymic" Text="{Binding Patronymic}" HorizontalAlignment="Center" VerticalAlignment="Top"
                 Width="400" Margin="10 190 10 10" FontSize="20"/>
        <TextBlock Text="Номер телефона:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="80 260 10 10" FontSize="20"/>
        <TextBox Name="tbPhone" Text="{Binding Phone, StringFormat={}{0:#(###)###-##-##}}" HorizontalAlignment="Center" VerticalAlignment="Top"
                 Width="270" Margin="10 260 10 10" FontSize="16"/>
        <RadioButton Name="rbMale" Content="Мужчина" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="10 315 150 10" FontSize="16"/>
        <RadioButton Name="rbFemale" Content="Женщина" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="150 315 10 10" FontSize="16" IsChecked="True"/>
        <TextBlock Name="textDate" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="10 355 10 10" FontSize="16" >
            <Run Text="Дата регистрации: "/><Run Text="{Binding RegistrationDate, StringFormat='{}{0:MM/dd/yyyy}'}"/></TextBlock>
        <Button Name="btnSave" VerticalAlignment="Bottom" HorizontalAlignment="Center" Click="btnSave_Click" Content="Сохранить"/>
    </Grid>
</Page>
